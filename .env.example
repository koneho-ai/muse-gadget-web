# SDK token from https://gadgets.muse.ai/settings/sdk-tokens (mgst_…)
# Stays on this host / in the state volume — never commit a filled copy.
MUSEGADGET_SDK_TOKEN=

# Shared secret for the BLE pairing relay (tools/ble_relay.py).
# Leave empty to disable the /pairing/ws endpoint entirely.
PAIRING_RELAY_SECRET=

# Name shown in the Muse app's device list and on the gadget's face.
DISPLAY_NAME=Muse Gadget (Web)
